{
  "name": "slugfetch",
  "private": true,
  "version": "11.4.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "server": "node server/index.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test server/*.test.mjs",
    "stripe:setup": "node scripts/stripe-setup.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "wrangler": "^4.135.0"
  }
}
